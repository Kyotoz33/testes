# senha do painel /admin.html (escolha uma forte)
ADMIN_PASSWORD=troque-esta-senha
# qualquer texto longo e aleatório; mantém você logado após reiniciar o servidor
SESSION_SECRET=
DISCORD_TOKEN=token_do_seu_bot
GUILD_ID=id_do_servidor_onde_o_bot_e_os_perfis_estao
# opcional: cria o primeiro perfil automaticamente na primeira execução
USER_ID=
# sites autorizados a usar a API (separe por vírgula)
ALLOWED_ORIGIN=https://tremdaselva.cc,https://www.tremdaselva.cc
PORT=3000
# onde os perfis ficam salvos (use um disco persistente!)
DATA_FILE=./data/profiles.json
STOCK_FILE=./data/stock.json
